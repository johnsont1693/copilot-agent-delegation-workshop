@page
@model ClinicalOpsLog.Pages.InboxModel
@using ClinicalOpsLog.Models
@{
    ViewData["Title"] = "Message Inbox";
}

<h1>Clinical Operations Message Inbox</h1>

<form method="get">
    <label for="Priority">Priority</label>
    <select id="Priority" name="Priority">
        <option value="">All priorities</option>
        @foreach (var priority in Enum.GetValues<MessagePriority>())
        {
            if (Model.Priority == priority)
            {
                <option value="@priority" selected>@priority</option>
            }
            else
            {
                <option value="@priority">@priority</option>
            }
        }
    </select>
    <button type="submit">Filter</button>
</form>

<p>@Model.TotalCount messages &mdash; @Model.UnacknowledgedCount unacknowledged</p>

<table>
    <thead>
        <tr>
            <th>Priority</th>
            <th>Subject</th>
            <th>Received</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var msg in Model.Messages)
        {
            <tr>
                <td>@msg.Priority</td>
                <td>@msg.Subject</td>
                <td>@msg.ReceivedAt.LocalDateTime.ToString("g")</td>
                <td>@(msg.IsAcknowledged ? "Acknowledged" : "Pending")</td>
            </tr>
        }
    </tbody>
</table>
